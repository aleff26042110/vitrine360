VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
# Keep supabase until the Worker and SQL migrations have been configured.
VITE_MEDIA_STORAGE=supabase
# Public Worker origin, never an R2 API secret. Example: https://your-worker.workers.dev
VITE_R2_GATEWAY_URL=
# Public billing API origin/path. Never place payment credentials here.
VITE_BILLING_API_URL=
