{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "vitrine360-media-gateway",
  "main": "worker.mjs",
  "account_id": "654558dee2b680d5e1765e2dcc0dfbac",
  "compatibility_date": "2026-10-11",
  "r2_buckets": [
    { "binding": "MEDIA_BUCKET", "bucket_name": "vitrine360-media", "remote": false }
  ],
  "vars": {
    "SUPABASE_URL": "https://msovfbuhehaiousuzbwr.supabase.co",
    "SUPABASE_CLIENT_KEY": "sb_publishable_bgEFclVFTCuLhKWHKx8eZw_jAt4eEUR",
    "ALLOWED_ORIGINS": "http://127.0.0.1:5188,http://localhost:5188,http://[::1]:5188"
  },
  "secrets": { "required": ["SUPABASE_SERVER_KEY"] },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 0.1, "invocation_logs": false },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  }
}
